<Window x:Class="SaveFileExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SaveFileExplorer"
        xmlns:comp="clr-namespace:SaveFileExplorer.Components"
        mc:Ignorable="d"
        Title="File Explorer" Height="800" Width="1200">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Open player directory"/>
                <MenuItem Header="Open file"/>
            </MenuItem>
            <MenuItem Header="Detected Players"/>
            <MenuItem Header="Help">
                <MenuItem Header="About"/>
            </MenuItem>
        </Menu>
        <TabControl>
            <TabItem Header="Playername : Player.chr">
                <comp:FileContentControl/>
            </TabItem>
            <TabItem Header="Playername : winsyx.dxb">
                <Label Content="Not supported yet"/>
            </TabItem>
            <TabItem Header="Playername : winsys.dxg">
                <Label Content="Not supported yet"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
