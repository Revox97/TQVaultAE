<UserControl x:Class="SaveFileExplorer.Components.FileContentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SaveFileExplorer.Components"
             mc:Ignorable="d" 
             Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="Info_Value" TargetType="{x:Type TextBox}">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Padding" Value="2"/>
                <Setter Property="BorderBrush" Value="Gray"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width=".5*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="File Infos" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
            <StackPanel>
                <Label Content="I am a file path"/>
                <StackPanel Orientation="Horizontal">
                    <Label Content="File Size:"/>
                    <Label Content="1001010"/>
                    <Label Content="Name:"/>
                    <Label Content="Playername"/>
                    <Label Content="Ext:"/>
                    <Label Content=".chr"/>
                    <Label Content="Version:"/>
                    <Label Content="TQAE"/>
                    <Label Content="Found Keys:"/>
                    <Label Content="140"/>
                    <Label Content="Data Type Errors:"/>
                    <Label Content="0/4996"/>
                    <Label Content="Unknown segments"/>
                    <Label Content="0/4996"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Detected Keys" Grid.Row="1" Grid.Column="0">
            <TreeView x:Name="KeyTreeView"/>
        </GroupBox>
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <GroupBox Header="KeyInfos" Grid.Row="0" Grid.Column="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Name"/>
                        <Label x:Name="KeyName"/>
                        <Label Content="Offset"/>
                        <Label x:Name="KeyOffset"/>
                        <Label Content="Length"/>
                        <Label x:Name="KeyLength"/>
                        <Label Content="IsSubStructureOpening"/>
                        <Label x:Name="KeyIsSubStructureOpening"/>
                        <Label Content="IsStructureClosing"/>
                        <Label x:Name="KeyIsStructureClosing"/>
                    </StackPanel>
                    <!-- Add Bindings -->
                    <StackPanel Orientation="Horizontal">
                        <Label Content="IsUnknownSegment"/>
                        <Label Content="False"/>
                        <Label Content="IsDataTypeError"/>
                        <Label Content="False"/>
                        <Label Content="IsKeyValue"/>
                        <Label Content="False"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Key Data" Grid.Row="1" Grid.Column="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                        <Label Content="Offset:"/>
                        <Label x:Name="ValueOffset"/>
                        <Label Content="Data Length:"/>
                        <Label x:Name="ValueDataLength"/>
                        <Label Content="Data Type"/>
                        <Label x:Name="ValueDataType"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="As Int:"/>
                        <TextBox Grid.Row="0" Grid.Column="2" Style="{StaticResource Info_Value}" x:Name="ValueAsInt"/>
                        <Label Grid.Row="1" Grid.Column="0" Content="As Bool:"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource Info_Value}" x:Name="ValueAsBool"/>
                        <Label Grid.Row="2" Grid.Column="0" Content="As String:"/>
                        <TextBox IsReadOnly="True" Grid.Row="2" Grid.Column="2" Style="{StaticResource Info_Value}" x:Name="ValueAsString"/>
                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Stretch">
                            <Label Content="As byte array:"/>
                            <TextBox VerticalAlignment="Stretch" x:Name="ValueAsRaw" Style="{StaticResource Info_Value}" TextWrapping="Wrap" Background="Gray"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
