<Window x:Class="TQVaultAE.UI.ItemDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TQVaultAE.UI"
        xmlns:model="clr-namespace:TQVaultAE.UI.Models;assembly=TQVaultAE.UI"
        xmlns:conv="clr-namespace:TQVaultAE.UI.Converters"
        d:DataContext="{d:DesignInstance Type=model:ItemDetailWindowModel, IsDesignTimeCreatable=True}"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#DD000000"
        Title="ItemDetailWindow" Height="Auto" Width="Auto">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:ItemRequirementToVisibilityConverter x:Key="ItemRequirementToVisibilityConverter"/>
        <Style x:Key="LabelBase" TargetType="{x:Type Label}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2 0"/>
            <Setter Property="Foreground" Value="Gray"/>
        </Style>
        <Style x:Key="LabelName" TargetType="{x:Type Label}" BasedOn="{StaticResource LabelBase}">
            <Setter Property="Foreground" Value="{Binding Item.HoverColor}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
        </Style>
        <Style x:Key="LabelDescription" TargetType="{x:Type Label}" BasedOn="{StaticResource LabelBase}">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="LabelAttribute" TargetType="{x:Type Label}" BasedOn="{StaticResource LabelBase}">
            <Setter Property="Foreground" Value="#00a2ff"/>
        </Style>
        <Style x:Key="HorizontalLine" TargetType="{x:Type Grid}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Gray"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="1 5"/>
        </Style>
    </Window.Resources>
    <Border BorderThickness="1" BorderBrush="Gray" Width="Auto" Height="Auto">
        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="Auto" Width="Auto" Margin="5" x:Name="DataContainer">
            <Label Style="{StaticResource LabelName}" Content="{Binding ItemName}" d:Content="Rancor Of Fire" d:Foreground="GreenYellow"/>
            <Label Style="{StaticResource LabelDescription}" Content="{Binding Item.Description}" d:Content="75 - 91 Damage"/>
            <Label Style="{StaticResource LabelDescription}" Content="{Binding Item.AdditionalDescription}" d:Content="Speed: Average" 
                   Visibility="{Binding Item.HasAdditionalDescription, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=COLLAPSED}" d:Visibility="Visible"/>

            <ListView BorderThickness="0" Background="Transparent" Padding="0" Height="auto" ItemsSource="{Binding Item.Attributes}" d:ItemsSource="{Binding DesignAttributes}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}">
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Label Style="{StaticResource LabelAttribute}" Margin="0" Content="{Binding Value}"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Style="{StaticResource HorizontalLine}"/>
            <Label Style="{StaticResource LabelBase}" Content="{Binding ItemSeedValue}" d:Content="itemSeed: 12345 (0x00001234) (19.4%)"/>
            <Label Style="{StaticResource LabelBase}" Foreground="Green" Content="{Binding ItemDlcName}" d:Content="Immortal Throne Item"
                   Visibility="{Binding Item.IsDlc, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=COLLAPSED}" d:Visibility="Visible"/>

            <Grid Style="{StaticResource HorizontalLine}"
                  Visibility="{Binding Item.Requirements, Converter={StaticResource ItemRequirementToVisibilityConverter}}" d:Visibility="Visible"/>
            <Label Style="{StaticResource LabelBase}"
                   Visibility="{Binding Item.Requirements, Converter={StaticResource ItemRequirementToVisibilityConverter}, ConverterParameter=STRENGTH}" d:Visibility="Visible">
                <Label.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Required Strength: "/>
                        <TextBlock Text="{Binding Item.Requirements.Strength}" d:Text="314"/>
                    </StackPanel>
                </Label.Content>
            </Label>
            <Label Style="{StaticResource LabelBase}"
                   Visibility="{Binding Item.Requirements, Converter={StaticResource ItemRequirementToVisibilityConverter}, ConverterParameter=DEXTERITY}" d:Visibility="Visible">
                <Label.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Required Dexterity: "/>
                        <TextBlock Text="{Binding Item.Requirements.Dexterity}" d:Text="83"/>
                    </StackPanel>
                </Label.Content>
            </Label>
            <Label Style="{StaticResource LabelBase}"
                   Visibility="{Binding Item.Requirements, Converter={StaticResource ItemRequirementToVisibilityConverter}, ConverterParameter=INTELLIGENCE}" d:Visibility="Visible">
                <Label.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Required Intelligence: "/>
                        <TextBlock Text="{Binding Item.Requirements.Intelligence}" d:Text="0"/>
                    </StackPanel>
                </Label.Content>
            </Label>
            <Label Style="{StaticResource LabelBase}"
                   Visibility="{Binding Item.Requirements, Converter={StaticResource ItemRequirementToVisibilityConverter}, ConverterParameter=LEVEL}" d:Visibility="Visible">
                <Label.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Required Player Level: "/>
                        <TextBlock Text="{Binding Item.Requirements.Level}" d:Text="29"/>
                    </StackPanel>
                </Label.Content>
            </Label>
        </StackPanel>
    </Border>
</Window>
