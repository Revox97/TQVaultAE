<Window x:Class="TQVaultAE.UI.ItemDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TQVaultAE.UI"
        mc:Ignorable="d"
        WindowStyle="None"
        Background="#44000000"
        Title="ItemDetailWindow" Height="Auto" Width="Auto">
    <Window.Resources>
        <Style x:Key="LabelBase" TargetType="{x:Type Label}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2 0"/>
            <Setter Property="Foreground" Value="Gray"/>
        </Style>
        <Style x:Key="LabelName" TargetType="{x:Type Label}" BasedOn="{StaticResource LabelBase}">
            <Setter Property="Foreground" Value="GreenYellow"/><!-- Bind color -->
        </Style>
        <Style x:Key="LabelDescription" TargetType="{x:Type Label}" BasedOn="{StaticResource LabelBase}">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="LabelAttribute" TargetType="{x:Type Label}" BasedOn="{StaticResource LabelBase}">
            <Setter Property="Foreground" Value="Blue"/>
        </Style>
        <Style x:Key="HorizontalLine" TargetType="{x:Type Grid}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Gray"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="1 5"/>
        </Style>
    </Window.Resources>
    <Border BorderThickness="1" BorderBrush="Gray" Width="Auto" Height="Auto">
        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="Auto" Width="Auto" Margin="5" x:Name="DataContainer">
            <Label Style="{StaticResource LabelName}" Content="Rancor Of Fire"/>
            <Label Style="{StaticResource LabelDescription}" Content="75 - 91 Damage"/>
            <Label Style="{StaticResource LabelDescription}" Content="Speed: Average"/>

            <!-- TODO Make this a collection -->
            <Label Style="{StaticResource LabelAttribute}" Content="15 Vitality Damage"/>
            <Label Style="{StaticResource LabelAttribute}" Content="3.0% Chance of 50 % Reduction to Enemy's Health"/>
            <Label Style="{StaticResource LabelAttribute}" Content="6 Fire Damage"/>
            <Label Style="{StaticResource LabelAttribute}" Content="+8% Fire Damage"/>
            <Label Style="{StaticResource LabelAttribute}" Content="+8% Burn Damage"/>

            <Grid Style="{StaticResource HorizontalLine}"/>
            <Label Style="{StaticResource LabelBase}" Content="itemSeed: 12345 (0x00001234) (19.4%)"/>
            <Label Style="{StaticResource LabelBase}" Foreground="Green" Content="Immortal Throne Item"/>

            <!-- TODO Only show if item has requirements -->
            <Grid Style="{StaticResource HorizontalLine}"/>
            <Label Style="{StaticResource LabelBase}">
                <Label.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Required Strength: "/>
                        <TextBlock Text="314"/>
                    </StackPanel>
                </Label.Content>
            </Label>
            <Label Style="{StaticResource LabelBase}">
                <Label.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Required Dexterity: "/>
                        <TextBlock Text="83"/>
                    </StackPanel>
                </Label.Content>
            </Label>
            <Label Style="{StaticResource LabelBase}" Visibility="Collapsed">
                <Label.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Required Intelligence: "/>
                        <TextBlock Text="0"/>
                    </StackPanel>
                </Label.Content>
            </Label>
            <Label Style="{StaticResource LabelBase}">
                <Label.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Required Player Level: "/>
                        <TextBlock Text="29"/>
                    </StackPanel>
                </Label.Content>
            </Label>
        </StackPanel>
    </Border>
</Window>
