<Window x:Class="SaveFileExplorer.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SaveFileExplorer"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="About Save File Explorer" Height="320" Width="500">
    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="AboutLabel" TargetType="{x:Type Label}">
                <Setter Property="Padding" Value="1"/>
            </Style>
            <Style x:Key="AboutLabel-Title" TargetType="{x:Type Label}" BasedOn="{StaticResource AboutLabel}">
                <Setter Property="Padding" Value="1"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0 0 0 10"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <!-- TODO Replace with actual image-->
        <Image Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" Source="https://placekittens.com/300/500"/>
        <StackPanel Grid.Row="1" Grid.Column="3">
            <Label Style="{StaticResource AboutLabel-Title}" Content="Save File Explorer"/>
            <!-- TODO Bind actual values -->
            <Label Style="{StaticResource AboutLabel}" Content="Version 2.0.0.0"/>
            <Label Style="{StaticResource AboutLabel}" Content="Copyright © 2019 by hguy"/>
            <Label Style="{StaticResource AboutLabel}" Content="Copyright © 2025 by Revox97"/>
            <Label Style="{StaticResource AboutLabel}" Content="titanquest.net community"/>
        </StackPanel>
        <ScrollViewer Grid.Row="2" Grid.Column="3" Background="Green" Margin="0 10 5 10">
            <TextBox VerticalContentAlignment="Stretch" TextWrapping="Wrap"
                     Text="Tool for exploring Titan Quest's save files."/>
        </ScrollViewer>
        <Button Content="OK" Grid.Row="3" Grid.Column="3" HorizontalAlignment="Right" Width="50" Click="ButtonOk_Click"/>
    </Grid>
</Window>
