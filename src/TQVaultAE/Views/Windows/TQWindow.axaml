<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:TQVaultAE.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="450"
        x:DataType="vm:TQWindowViewModel"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="1"
        x:Class="TQVaultAE.Views.Windows.TQWindow"
        CanResize="{Binding CanResize}"
        Resized="Window_Resized"
        Icon="/Assets/Img/icon_majestic_chest.png"
        Title="TQWindow" Height="{Binding Height}" Width="{Binding Width}"
        Window.WindowDecorations="BorderOnly">
    <Window.Styles>
        <StyleInclude Source="avares://TQVaultAE/Styles/TQWindowStyles.axaml"/>
    </Window.Styles>
    <Design.DataContext>
        <vm:TQWindowViewModel/>
    </Design.DataContext>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="19"/>
            <RowDefinition Height="11"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="27"/>
            <RowDefinition Height="4"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="4"/>
        </Grid.ColumnDefinitions>

        <!-- TODO Content goes here -->
        <Grid x:Name="ContentContainer" Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" Grid.RowSpan="4"/>

        <!-- BORDER TOP -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="19"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="31"/>
            </Grid.ColumnDefinitions>

            <!-- Border TOP-LEFT-CORNER-->
            <Border Grid.Row="0" Grid.Column="0" Classes="BorderTopLeftCorner"/>

            <!-- BORDER TOP-LEFT -->
            <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Classes="BorderTopLeft"/>

            <!-- BORDER TOP-CENTER -->
            <Border Grid.Row="0" Grid.Column="2" Classes="BorderTopCenter" x:Name="BorderTopCenter">
                <Label Content="{Binding Title}" Classes="LabelTitle"/>
            </Border>

            <!-- BORDER TOP-RIGHT -->
            <Border Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" Classes="BorderTopRight"/>

            <!-- MIN/MAX BUTTONS -->
            <Grid Grid.Column="3" Grid.Row="0" HorizontalAlignment="Right" IsVisible="{Binding CanResize}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="4"/>
                </Grid.ColumnDefinitions>
                <Button Margin="2" Grid.Column="0" Classes="ButtonNavigation ButtonMinimize" Command="{Binding MinimizeCommand}"/>
                <Button Margin="2" Grid.Column="2" Classes="ButtonNavigation ButtonMaximize" Command="{Binding MaximizeCommand}"/>
            </Grid>
        </Grid>
        
        <!-- Button Close -->
        <Button Grid.Row="0" Margin="0 3 0 0" Grid.RowSpan="2" Grid.Column="3" Grid.ColumnSpan="2" Command="{Binding CloseCommand}" Classes="ButtonNavigation ButtonClose"/>

         <!-- Border left -->
        <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="0" Classes="BorderSide"/>

        <!-- Border right -->
        <Border Grid.Row="2" Grid.RowSpan="2" Grid.Column="4" Classes="BorderSide"/>

        <!-- Border corner bottom left -->
        <Border Grid.Row="4" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" Classes="BorderBottomLeft"/>

        <!-- Border bottom -->
        <Border Grid.Row="5" Grid.Column="2" Classes="BorderBottom"/>

        <!-- Border corner bottom right -->
        <Border Grid.Row="4" Grid.RowSpan="2" Grid.Column="3" Grid.ColumnSpan="2" Classes="BorderBottomRight"/>
    </Grid>
</Window>
