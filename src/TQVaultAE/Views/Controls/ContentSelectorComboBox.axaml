<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TQVaultAE.ViewModels"
             x:DataType="vm:ContentSelectorComboBoxViewModel"
             Background="Transparent"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="60"
             x:Class="TQVaultAE.Views.Controls.ContentSelectorComboBox">
    <DockPanel Margin="0" Width="350" HorizontalAlignment="Left">
        <Border Width="70" Height="70" Background="{Binding Icon}" HorizontalAlignment="Left"/>
        <ComboBox VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0 0 2 0"
                  ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </DockPanel>
</UserControl>
