<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="250" d:DesignHeight="350"
             x:Name="root"
             x:Class="TQVaultAE.Views.Controls.ItemPopup">
    <Border BorderBrush="LightGray" BorderThickness="1" Background="#CC000000">
        <StackPanel Margin="1">
            <TextBlock>
                <Run FontWeight="DemiBold" Foreground="LightBlue" Text="{Binding DataSource.Name, ElementName=root}"/>
                <LineBreak/>
                <Run Foreground="White" Text="Item type"/>
                <LineBreak/>
                <Run Foreground="Blue" Text="Item prop 1"/>
                <LineBreak/>
                <Run Foreground="Blue" Text="Item prop 2"/>
                <LineBreak/>
                <Run Foreground="Blue" Text="Item prop 3"/>
                <LineBreak/>
                <LineBreak/>
                <Run Foreground="White" Text="asdfs"/>
                <LineBreak/>
                <Separator Foreground="White" Background="White" Width="200"/>
                <LineBreak/>
                <Run Foreground="White" Text="Seed: 0x1232"/>
                <LineBreak/>
                <Separator Foreground="White" Background="White" Width="200"/>
                <LineBreak/>
                <Run Foreground="White" Text="Required Level: x"/>
            </TextBlock>
            
        </StackPanel>
    </Border>
</UserControl>
