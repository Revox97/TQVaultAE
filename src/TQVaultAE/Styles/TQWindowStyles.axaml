<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20" Background="LightGray">
        <StackPanel Orientation="Horizontal">
            <Border Classes="BorderSide" Height="250" Width="5" Margin="5"/>
            <StackPanel>
                <Border Margin="10" HorizontalAlignment="Center">
                    <Label Classes="LabelTitle" Content="TQVaultAE 5.0.0.0"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="50" Height="50" Margin="10">
                        <Button Classes="ButtonNavigation ButtonMinimize" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Border>
                    <Border Width="50" Height="50" Margin="10">
                        <Button Classes="ButtonNavigation ButtonMaximize" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Border>
                    <Border Width="50" Height="50" Margin="10">
                        <Button Classes="ButtonNavigation ButtonClose" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Border>
                </StackPanel>
                <Border Classes="BorderTopLeft" Height="10" Width="200" Margin="5"/>
                <Border Classes="BorderTopCenter" Height="10" Width="200" Margin="5"/>
                <Border Classes="BorderTopRight" Height="10" Width="200" Margin="5"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Classes="BorderBottomLeft" Height="20" Width="20" Margin="5"/>
                    <Border Classes="BorderTopLeftCorner" Height="40" Width="5" Margin="5"/>
                    <Border Classes="BorderBottomRight" Height="20" Width="20" Margin="5"/>
                </StackPanel>
                <Border Classes="BorderBottom" Height="5" Width="200" Margin="5"/>
            </StackPanel>
            <Border Classes="BorderSide" Height="250" Width="5" Margin="5"/>
        </StackPanel>
    </Border>
  </Design.PreviewWith>
    <Style Selector="Button.ButtonNavigation">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="Button.ButtonMinimize">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush Source="avares://TQVaultAE/Assets/Img/button_minimize_up.png"
                            TileMode="None" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
            </Setter.Value> 
        </Setter>
    </Style>

    <Style Selector="Button.ButtonMinimize:pointerover">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush Source="avares://TQVaultAE/Assets/Img/button_minimize_over.png"
                            TileMode="None" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Button.ButtonMinimize:pressed">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush Source="avares://TQVaultAE/Assets/Img/button_minimize_down.png"
                            TileMode="None" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Button.ButtonMaximize">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush Source="avares://TQVaultAE/Assets/Img/button_maximize_up.png"
                            TileMode="None" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
            </Setter.Value> 
        </Setter>
    </Style>

    <Style Selector="Button.ButtonMaximize:pointerover">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush Source="avares://TQVaultAE/Assets/Img/button_maximize_over.png"
                            TileMode="None" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Button.ButtonMaximize:pressed">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush Source="avares://TQVaultAE/Assets/Img/button_maximize_down.png"
                            TileMode="None" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Button.ButtonClose">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush Source="avares://TQVaultAE/Assets/Img/button_close_up.png"
                            TileMode="None" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Margin" Value="0 1 0 0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <Style Selector="Button.ButtonClose:pointerover">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush Source="avares://TQVaultAE/Assets/Img/button_close_over.png"
                            TileMode="None" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Button.ButtonClose:pressed">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush Source="avares://TQVaultAE/Assets/Img/button_close_down.png"
                            TileMode="None" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Label.LabelTitle">
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Height" Value="19"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Padding" Value="7 1 7 2"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.BorderTopLeftCorner">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush Source="avares://TQVaultAE/Assets/Img/window_border_corner_top_left.png"
                            AlignmentX="Left" AlignmentY="Top" TileMode="None" Stretch="Fill"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Border.BorderTopLeft">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush Source="avares://TQVaultAE/Assets/Img/window_border_top_left.png"
                            AlignmentX="Left" AlignmentY="Top" TileMode="None" Stretch="Fill"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Border.BorderTopRight">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush Source="avares://TQVaultAE/Assets/Img/window_border_top_right.png"
                            AlignmentX="Left" AlignmentY="Center" TileMode="None" Stretch="Fill"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Border.BorderTopCenter">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush Source="avares://TQVaultAE/Assets/Img/window_border_top_center.png"
                            AlignmentX="Left" AlignmentY="Center" TileMode="None" Stretch="Fill"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Border.BorderSide">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush Source="avares://TQVaultAE/Assets/Img/window_border_side.png"
                            Stretch="Fill" AlignmentX="Center" AlignmentY="Top" TileMode="None"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Border.BorderBottom">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush Source="avares://TQVaultAE/Assets/Img/window_border_bottom.png"
                            Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Bottom" TileMode="None"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Border.BorderBottomLeft">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush Source="avares://TQVaultAE/Assets/Img/window_border_corner_bottom_left.png"
                            Stretch="UniformToFill" AlignmentX="Left" AlignmentY="Bottom" TileMode="None"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Border.BorderBottomRight">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush Source="avares://TQVaultAE/Assets/Img/window_border_corner_bottom_right.png"
                            Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Bottom" TileMode="None"/>
            </Setter.Value>
        </Setter>
    </Style>
</Styles>
